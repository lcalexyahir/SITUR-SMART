# ============================================================
# SITUR-SMART (backend movil) - Variables de entorno
# Copie este archivo como .env para desarrollo local.
# NUNCA suba el archivo .env al repositorio.
# ============================================================

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (Railway -> servicio Postgres -> Variables -> DATABASE_PUBLIC_URL)
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:PUERTO/railway

# Clientes autorizados (web)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# Tokens
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ============================================================
# En Railway (servicio backend -> Variables) defina:
#   DJANGO_SETTINGS_MODULE=config.settings.production
#   DJANGO_SECRET_KEY=<clave aleatoria larga>
#   DJANGO_DEBUG=false
#   DJANGO_ALLOWED_HOSTS=<dominio>.up.railway.app
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   ACCESS_TOKEN_MINUTES=15
#   REFRESH_TOKEN_DAYS=7
# ============================================================